#version 430 core
layout(local_size_x = 32, local_size_y = 2, local_size_z = 2) in;
layout(std430, binding = 0) buffer PBuf { float p[]; };
layout(std430, binding = 1) readonly buffer DBuf { float div[]; };
uniform int u_n, u_parity;
uniform float u_omega, u_h2_div_dt;
void main() {
    int y = int(gl_GlobalInvocationID.y), z = int(gl_GlobalInvocationID.z);
    // Launch only the selected color, with neighboring lanes along X.
    int x = 2 * int(gl_GlobalInvocationID.x) + ((y + z + u_parity) & 1);
    if (x >= u_n || y >= u_n || z >= u_n) return;
    int i = x + u_n * (y + u_n * z);
    int plane = u_n * u_n;
    float center = p[i];
    float sum = 0.0;
    sum += x > 0 ? p[i - 1] : center;
    sum += x + 1 < u_n ? p[i + 1] : center;
    sum += y > 0 ? p[i - u_n] : center;
    sum += y + 1 < u_n ? p[i + u_n] : center;
    sum += z > 0 ? p[i - plane] : center;
    sum += z + 1 < u_n ? p[i + plane] : center;
    p[i] = (1.0 - u_omega) * center + u_omega * (sum - div[i] * u_h2_div_dt) / 6.0;
}
